rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validCaseIds() {
      return [
        'clientes-bloqueados',
        'estoque-abaixo-minimo',
        'motivos-cancelamento',
        'vendas-nao-efetivadas',
        'itens-fora-preco-tabela',
        'caixas-sem-fechamento',
        'compradores-unicos-alto-valor',
        'produtos-vendidos-prejuizo',
        'ranking-vendedores-filial',
        'icms-desonerado-devolucao',
        'valor-final-divergente-ipi',
        'vencimento-parcela-divergente',
        'caixa-travado-funcionario-inativo',
        'bug-troco-forma-pagamento',
        'rejeicao-535-frete',
        'sped-icms-cst60-entrada',
        'frete-cobrado-outras-despesas',
        'data-emissao-futura'
      ];
    }

    function validObjectiveIds() {
      return ['o1', 'o2', 'o3'];
    }

    function validObjectiveKeys() {
      return [
        'clientes-bloqueados:o1',
        'clientes-bloqueados:o2',
        'clientes-bloqueados:o3',
        'estoque-abaixo-minimo:o1',
        'estoque-abaixo-minimo:o2',
        'estoque-abaixo-minimo:o3',
        'motivos-cancelamento:o1',
        'motivos-cancelamento:o2',
        'motivos-cancelamento:o3',
        'vendas-nao-efetivadas:o1',
        'vendas-nao-efetivadas:o2',
        'vendas-nao-efetivadas:o3',
        'itens-fora-preco-tabela:o1',
        'itens-fora-preco-tabela:o2',
        'itens-fora-preco-tabela:o3',
        'caixas-sem-fechamento:o1',
        'caixas-sem-fechamento:o2',
        'caixas-sem-fechamento:o3',
        'compradores-unicos-alto-valor:o1',
        'compradores-unicos-alto-valor:o2',
        'compradores-unicos-alto-valor:o3',
        'produtos-vendidos-prejuizo:o1',
        'produtos-vendidos-prejuizo:o2',
        'produtos-vendidos-prejuizo:o3',
        'ranking-vendedores-filial:o1',
        'ranking-vendedores-filial:o2',
        'ranking-vendedores-filial:o3',
        'icms-desonerado-devolucao:o1',
        'icms-desonerado-devolucao:o2',
        'icms-desonerado-devolucao:o3',
        'valor-final-divergente-ipi:o1',
        'valor-final-divergente-ipi:o2',
        'valor-final-divergente-ipi:o3',
        'vencimento-parcela-divergente:o1',
        'vencimento-parcela-divergente:o2',
        'vencimento-parcela-divergente:o3',
        'caixa-travado-funcionario-inativo:o1',
        'caixa-travado-funcionario-inativo:o2',
        'caixa-travado-funcionario-inativo:o3',
        'bug-troco-forma-pagamento:o1',
        'bug-troco-forma-pagamento:o2',
        'bug-troco-forma-pagamento:o3',
        'rejeicao-535-frete:o1',
        'rejeicao-535-frete:o2',
        'rejeicao-535-frete:o3',
        'sped-icms-cst60-entrada:o1',
        'sped-icms-cst60-entrada:o2',
        'sped-icms-cst60-entrada:o3',
        'frete-cobrado-outras-despesas:o1',
        'frete-cobrado-outras-despesas:o2',
        'frete-cobrado-outras-despesas:o3',
        'data-emissao-futura:o1',
        'data-emissao-futura:o2',
        'data-emissao-futura:o3'
      ];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function maxDraftSqlLength() {
      return 20000;
    }

    function hasOnlyAppFields() {
      return request.resource.data.keys().hasOnly(
        ['solvedByCase', 'hintsUsedByCase', 'draftsByCase']
      );
    }

    function isValidObjectiveList(list) {
      return list is list
        && list.size() <= validObjectiveIds().size()
        && list.hasOnly(validObjectiveIds());
    }

    function isValidProgressMap(data) {
      return data is map
        && data.keys().hasOnly(validCaseIds())
        && (!('clientes-bloqueados' in data) || isValidObjectiveList(data['clientes-bloqueados']))
        && (!('estoque-abaixo-minimo' in data) || isValidObjectiveList(data['estoque-abaixo-minimo']))
        && (!('motivos-cancelamento' in data) || isValidObjectiveList(data['motivos-cancelamento']))
        && (!('vendas-nao-efetivadas' in data) || isValidObjectiveList(data['vendas-nao-efetivadas']))
        && (!('itens-fora-preco-tabela' in data) || isValidObjectiveList(data['itens-fora-preco-tabela']))
        && (!('caixas-sem-fechamento' in data) || isValidObjectiveList(data['caixas-sem-fechamento']))
        && (!('compradores-unicos-alto-valor' in data) || isValidObjectiveList(data['compradores-unicos-alto-valor']))
        && (!('produtos-vendidos-prejuizo' in data) || isValidObjectiveList(data['produtos-vendidos-prejuizo']))
        && (!('ranking-vendedores-filial' in data) || isValidObjectiveList(data['ranking-vendedores-filial']))
        && (!('icms-desonerado-devolucao' in data) || isValidObjectiveList(data['icms-desonerado-devolucao']))
        && (!('valor-final-divergente-ipi' in data) || isValidObjectiveList(data['valor-final-divergente-ipi']))
        && (!('vencimento-parcela-divergente' in data) || isValidObjectiveList(data['vencimento-parcela-divergente']))
        && (!('caixa-travado-funcionario-inativo' in data) || isValidObjectiveList(data['caixa-travado-funcionario-inativo']))
        && (!('bug-troco-forma-pagamento' in data) || isValidObjectiveList(data['bug-troco-forma-pagamento']))
        && (!('rejeicao-535-frete' in data) || isValidObjectiveList(data['rejeicao-535-frete']))
        && (!('sped-icms-cst60-entrada' in data) || isValidObjectiveList(data['sped-icms-cst60-entrada']))
        && (!('frete-cobrado-outras-despesas' in data) || isValidObjectiveList(data['frete-cobrado-outras-despesas']))
        && (!('data-emissao-futura' in data) || isValidObjectiveList(data['data-emissao-futura']));
    }

    function isValidProgressField(name) {
      return !(name in request.resource.data) || isValidProgressMap(request.resource.data[name]);
    }

    function isValidQueries(queries) {
      return queries is map
        && queries.keys().hasOnly(validObjectiveIds())
        && (!('o1' in queries) || (queries['o1'] is string && queries['o1'].size() <= maxDraftSqlLength()))
        && (!('o2' in queries) || (queries['o2'] is string && queries['o2'].size() <= maxDraftSqlLength()))
        && (!('o3' in queries) || (queries['o3'] is string && queries['o3'].size() <= maxDraftSqlLength()));
    }

    function isValidDraft(draft) {
      return draft is map
        && draft.keys().hasOnly(['activeObjectiveId', 'queries'])
        && (!('activeObjectiveId' in draft)
            || draft.activeObjectiveId in validObjectiveIds())
        && (!('queries' in draft) || isValidQueries(draft.queries));
    }

    function isValidDraftsMap(data) {
      return data is map
        && data.keys().hasOnly(validCaseIds())
        && (!('clientes-bloqueados' in data) || isValidDraft(data['clientes-bloqueados']))
        && (!('estoque-abaixo-minimo' in data) || isValidDraft(data['estoque-abaixo-minimo']))
        && (!('motivos-cancelamento' in data) || isValidDraft(data['motivos-cancelamento']))
        && (!('vendas-nao-efetivadas' in data) || isValidDraft(data['vendas-nao-efetivadas']))
        && (!('itens-fora-preco-tabela' in data) || isValidDraft(data['itens-fora-preco-tabela']))
        && (!('caixas-sem-fechamento' in data) || isValidDraft(data['caixas-sem-fechamento']))
        && (!('compradores-unicos-alto-valor' in data) || isValidDraft(data['compradores-unicos-alto-valor']))
        && (!('produtos-vendidos-prejuizo' in data) || isValidDraft(data['produtos-vendidos-prejuizo']))
        && (!('ranking-vendedores-filial' in data) || isValidDraft(data['ranking-vendedores-filial']))
        && (!('icms-desonerado-devolucao' in data) || isValidDraft(data['icms-desonerado-devolucao']))
        && (!('valor-final-divergente-ipi' in data) || isValidDraft(data['valor-final-divergente-ipi']))
        && (!('vencimento-parcela-divergente' in data) || isValidDraft(data['vencimento-parcela-divergente']))
        && (!('caixa-travado-funcionario-inativo' in data) || isValidDraft(data['caixa-travado-funcionario-inativo']))
        && (!('bug-troco-forma-pagamento' in data) || isValidDraft(data['bug-troco-forma-pagamento']))
        && (!('rejeicao-535-frete' in data) || isValidDraft(data['rejeicao-535-frete']))
        && (!('sped-icms-cst60-entrada' in data) || isValidDraft(data['sped-icms-cst60-entrada']))
        && (!('frete-cobrado-outras-despesas' in data) || isValidDraft(data['frete-cobrado-outras-despesas']))
        && (!('data-emissao-futura' in data) || isValidDraft(data['data-emissao-futura']));
    }

    function isValidDraftsField(name) {
      return !(name in request.resource.data) || isValidDraftsMap(request.resource.data[name]);
    }

    // Regras de escrita do progresso: custo proporcional ao que MUDOU, nao ao
    // tamanho do documento. O Firestore corta a requisicao em 1.000 expressoes,
    // e validar tudo a cada escrita estourava isso em quem tem muito progresso.
    function caseListOk(list, previous) {
      return isValidObjectiveList(list) && list.hasAll(previous);
    }

    // solvedByCase / hintsUsedByCase: so crescem e so aceitam ids validos
    function progressChangeOk(field) {
      let oldMap = resource.data[field];
      let newMap = request.resource.data[field];
      let changed = newMap.diff(oldMap).affectedKeys();
      return newMap is map
        && changed.hasOnly(validCaseIds())
        && (!changed.hasAny(['clientes-bloqueados']) || caseListOk(newMap['clientes-bloqueados'], oldMap.get('clientes-bloqueados', [])))
        && (!changed.hasAny(['estoque-abaixo-minimo']) || caseListOk(newMap['estoque-abaixo-minimo'], oldMap.get('estoque-abaixo-minimo', [])))
        && (!changed.hasAny(['motivos-cancelamento']) || caseListOk(newMap['motivos-cancelamento'], oldMap.get('motivos-cancelamento', [])))
        && (!changed.hasAny(['vendas-nao-efetivadas']) || caseListOk(newMap['vendas-nao-efetivadas'], oldMap.get('vendas-nao-efetivadas', [])))
        && (!changed.hasAny(['itens-fora-preco-tabela']) || caseListOk(newMap['itens-fora-preco-tabela'], oldMap.get('itens-fora-preco-tabela', [])))
        && (!changed.hasAny(['caixas-sem-fechamento']) || caseListOk(newMap['caixas-sem-fechamento'], oldMap.get('caixas-sem-fechamento', [])))
        && (!changed.hasAny(['compradores-unicos-alto-valor']) || caseListOk(newMap['compradores-unicos-alto-valor'], oldMap.get('compradores-unicos-alto-valor', [])))
        && (!changed.hasAny(['produtos-vendidos-prejuizo']) || caseListOk(newMap['produtos-vendidos-prejuizo'], oldMap.get('produtos-vendidos-prejuizo', [])))
        && (!changed.hasAny(['ranking-vendedores-filial']) || caseListOk(newMap['ranking-vendedores-filial'], oldMap.get('ranking-vendedores-filial', [])))
        && (!changed.hasAny(['icms-desonerado-devolucao']) || caseListOk(newMap['icms-desonerado-devolucao'], oldMap.get('icms-desonerado-devolucao', [])))
        && (!changed.hasAny(['valor-final-divergente-ipi']) || caseListOk(newMap['valor-final-divergente-ipi'], oldMap.get('valor-final-divergente-ipi', [])))
        && (!changed.hasAny(['vencimento-parcela-divergente']) || caseListOk(newMap['vencimento-parcela-divergente'], oldMap.get('vencimento-parcela-divergente', [])))
        && (!changed.hasAny(['caixa-travado-funcionario-inativo']) || caseListOk(newMap['caixa-travado-funcionario-inativo'], oldMap.get('caixa-travado-funcionario-inativo', [])))
        && (!changed.hasAny(['bug-troco-forma-pagamento']) || caseListOk(newMap['bug-troco-forma-pagamento'], oldMap.get('bug-troco-forma-pagamento', [])))
        && (!changed.hasAny(['rejeicao-535-frete']) || caseListOk(newMap['rejeicao-535-frete'], oldMap.get('rejeicao-535-frete', [])))
        && (!changed.hasAny(['sped-icms-cst60-entrada']) || caseListOk(newMap['sped-icms-cst60-entrada'], oldMap.get('sped-icms-cst60-entrada', [])))
        && (!changed.hasAny(['frete-cobrado-outras-despesas']) || caseListOk(newMap['frete-cobrado-outras-despesas'], oldMap.get('frete-cobrado-outras-despesas', [])))
        && (!changed.hasAny(['data-emissao-futura']) || caseListOk(newMap['data-emissao-futura'], oldMap.get('data-emissao-futura', [])));
    }

    function progressFieldOk(field) {
      return (field in resource.data)
        ? progressChangeOk(field)
        : isValidProgressField(field);
    }

    // draftsByCase: valida so os casos que mudaram; rascunho pode encolher
    function draftsChangeOk() {
      let oldMap = resource.data.draftsByCase;
      let newMap = request.resource.data.draftsByCase;
      let changed = newMap.diff(oldMap).affectedKeys();
      return newMap is map
        && changed.hasOnly(validCaseIds())
        && (!changed.hasAny(['clientes-bloqueados']) || !('clientes-bloqueados' in newMap) || isValidDraft(newMap['clientes-bloqueados']))
        && (!changed.hasAny(['estoque-abaixo-minimo']) || !('estoque-abaixo-minimo' in newMap) || isValidDraft(newMap['estoque-abaixo-minimo']))
        && (!changed.hasAny(['motivos-cancelamento']) || !('motivos-cancelamento' in newMap) || isValidDraft(newMap['motivos-cancelamento']))
        && (!changed.hasAny(['vendas-nao-efetivadas']) || !('vendas-nao-efetivadas' in newMap) || isValidDraft(newMap['vendas-nao-efetivadas']))
        && (!changed.hasAny(['itens-fora-preco-tabela']) || !('itens-fora-preco-tabela' in newMap) || isValidDraft(newMap['itens-fora-preco-tabela']))
        && (!changed.hasAny(['caixas-sem-fechamento']) || !('caixas-sem-fechamento' in newMap) || isValidDraft(newMap['caixas-sem-fechamento']))
        && (!changed.hasAny(['compradores-unicos-alto-valor']) || !('compradores-unicos-alto-valor' in newMap) || isValidDraft(newMap['compradores-unicos-alto-valor']))
        && (!changed.hasAny(['produtos-vendidos-prejuizo']) || !('produtos-vendidos-prejuizo' in newMap) || isValidDraft(newMap['produtos-vendidos-prejuizo']))
        && (!changed.hasAny(['ranking-vendedores-filial']) || !('ranking-vendedores-filial' in newMap) || isValidDraft(newMap['ranking-vendedores-filial']))
        && (!changed.hasAny(['icms-desonerado-devolucao']) || !('icms-desonerado-devolucao' in newMap) || isValidDraft(newMap['icms-desonerado-devolucao']))
        && (!changed.hasAny(['valor-final-divergente-ipi']) || !('valor-final-divergente-ipi' in newMap) || isValidDraft(newMap['valor-final-divergente-ipi']))
        && (!changed.hasAny(['vencimento-parcela-divergente']) || !('vencimento-parcela-divergente' in newMap) || isValidDraft(newMap['vencimento-parcela-divergente']))
        && (!changed.hasAny(['caixa-travado-funcionario-inativo']) || !('caixa-travado-funcionario-inativo' in newMap) || isValidDraft(newMap['caixa-travado-funcionario-inativo']))
        && (!changed.hasAny(['bug-troco-forma-pagamento']) || !('bug-troco-forma-pagamento' in newMap) || isValidDraft(newMap['bug-troco-forma-pagamento']))
        && (!changed.hasAny(['rejeicao-535-frete']) || !('rejeicao-535-frete' in newMap) || isValidDraft(newMap['rejeicao-535-frete']))
        && (!changed.hasAny(['sped-icms-cst60-entrada']) || !('sped-icms-cst60-entrada' in newMap) || isValidDraft(newMap['sped-icms-cst60-entrada']))
        && (!changed.hasAny(['frete-cobrado-outras-despesas']) || !('frete-cobrado-outras-despesas' in newMap) || isValidDraft(newMap['frete-cobrado-outras-despesas']))
        && (!changed.hasAny(['data-emissao-futura']) || !('data-emissao-futura' in newMap) || isValidDraft(newMap['data-emissao-futura']));
    }

    function draftsFieldOk() {
      return !('draftsByCase' in request.resource.data)
        || (('draftsByCase' in resource.data)
            ? draftsChangeOk()
            : isValidDraftsField('draftsByCase'));
    }

    function validSectorIds() {
      return ['Partner', 'Final', 'Prime', 'Implantação', 'Outro'];
    }

    function isValidObjectiveKeyList(field) {
      return request.resource.data[field] is list
        && request.resource.data[field].hasOnly(validObjectiveKeys());
    }

    function isGrowingList(field) {
      return !(field in resource.data)
        || request.resource.data[field].hasAll(resource.data[field]);
    }

    function isValidSector() {
      return !('sector' in request.resource.data)
        || request.resource.data.sector == null
        || (request.resource.data.sector is string
            && request.resource.data.sector in validSectorIds());
    }

    function hasOnlyLeaderboardFields() {
      return request.resource.data.keys().hasOnly(
        ['displayName', 'solved', 'hints', 'sector', 'completedAt', 'updatedAt']
      );
    }

    function isValidLeaderboardFields() {
      return request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && isValidObjectiveKeyList('solved')
        && isValidObjectiveKeyList('hints')
        && isValidSector()
        && request.resource.data.solved.size() > 0;
    }

    function setsCompletionNow() {
      return !('completedAt' in request.resource.data)
        || request.resource.data.completedAt == request.time;
    }

    function keepsCompletion() {
      return !('completedAt' in resource.data)
        ? setsCompletionNow()
        : (('completedAt' in request.resource.data)
           && request.resource.data.completedAt == resource.data.completedAt);
    }

    function keepsSector() {
      return !('sector' in resource.data)
        || resource.data.sector == null
        || (('sector' in request.resource.data)
            && request.resource.data.sector == resource.data.sector);
    }

    // total de objetivos do app; o teste certificate-rules.spec.ts confere
    function certificateMinSolved() {
      return 53;
    }

    function leaderboardPath(uid) {
      return /databases/$(database)/documents/leaderboard/$(uid);
    }

    // quem concluiu tem a linha no placar carimbada e com todos os objetivos
    function hasFinishedArchive() {
      return exists(leaderboardPath(request.auth.uid))
        && ('completedAt' in get(leaderboardPath(request.auth.uid)).data)
        && get(leaderboardPath(request.auth.uid)).data.solved.size()
           >= certificateMinSolved();
    }

    function isValidCertificate(code) {
      return code.matches('^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$')
        && request.resource.data.keys().hasOnly(
          ['uid', 'name', 'hours', 'cases', 'objectives', 'xp', 'issuedAt']
        )
        && request.resource.data.keys().hasAll(
          ['uid', 'name', 'hours', 'cases', 'objectives', 'xp', 'issuedAt']
        )
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.hours is int
        && request.resource.data.hours == 10
        && request.resource.data.cases is int
        && request.resource.data.cases > 0
        && request.resource.data.cases <= 100
        && request.resource.data.objectives is int
        && request.resource.data.objectives >= certificateMinSolved()
        && request.resource.data.objectives <= 500
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 100000
        && request.resource.data.issuedAt == request.time;
    }

    function changes(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow delete: if false;

      allow create: if isOwner(userId)
        && hasOnlyAppFields()
        && isValidProgressField('solvedByCase')
        && isValidProgressField('hintsUsedByCase')
        && isValidDraftsField('draftsByCase');

      allow update: if isOwner(userId)
        && hasOnlyAppFields()
        && (!changes('solvedByCase') || progressFieldOk('solvedByCase'))
        && (!changes('hintsUsedByCase') || progressFieldOk('hintsUsedByCase'))
        && (!changes('draftsByCase') || draftsFieldOk());
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow delete: if false;

      allow create: if isOwner(userId)
        && hasOnlyLeaderboardFields()
        && isValidLeaderboardFields()
        && request.resource.data.updatedAt == request.time
        && setsCompletionNow();

      allow update: if isOwner(userId)
        && hasOnlyLeaderboardFields()
        && isValidLeaderboardFields()
        && isGrowingList('solved')
        && isGrowingList('hints')
        && request.resource.data.updatedAt == request.time
        && keepsCompletion()
        && keepsSector();
    }

    match /certificates/{code} {
      // o codigo impresso no certificado e o segredo: busca por ele e publica,
      // listar tudo nao e
      allow get: if true;
      allow list: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update, delete: if false;

      allow create: if request.auth != null
        && isValidCertificate(code)
        && hasFinishedArchive();
    }

    match /devs/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

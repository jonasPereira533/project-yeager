rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Objetivo resolvido, derivado de src/data/cases.ts: 9 casos, 3 objetivos
    // cada (o1, o2, o3).
    //
    // Ao adicionar ou remover um caso em cases.ts, atualize esta lista junto.
    // Estas regras são a barreira real contra XP auto-declarado: sem elas o
    // totalXP é computado no cliente a partir de um documento que o próprio
    // usuário escreve, então qualquer setDoc inventa objetivo à vontade.
    // ---------------------------------------------------------------------
    function validCaseIds() {
      return [
        'clientes-bloqueados',
        'estoque-abaixo-minimo',
        'motivos-cancelamento',
        'vendas-nao-efetivadas',
        'itens-fora-preco-tabela',
        'caixas-sem-fechamento',
        'compradores-unicos-alto-valor',
        'produtos-vendidos-prejuizo',
        'ranking-vendedores-filial'
      ];
    }

    function validObjectiveIds() {
      return ['o1', 'o2', 'o3'];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnlyProgressFields() {
      return request.resource.data.keys().hasOnly(
        ['solvedByCase', 'hintsUsedByCase']
      );
    }

    // Mapa caseId -> lista de objectiveId, com toda chave e todo valor
    // pertencentes às listas acima.
    //
    // values() devolve as LISTAS (não os ids de caso), então o predicado
    // trabalha sobre cada lista diretamente.
    function isValidProgressMap(data) {
      return data is map
        && data.keys().hasOnly(validCaseIds())
        && data.values().all(objectiveList,
             objectiveList is list
             && objectiveList.size() <= validObjectiveIds().size()
             && objectiveList.all(objectiveId, objectiveId in validObjectiveIds())
           );
    }

    function isValidProgressField(name) {
      return !(name in request.resource.data) || isValidProgressMap(request.resource.data[name]);
    }

    // Nenhum objetivo já registrado pode sumir. Sem isto, apagar um item e
    // reenviá-lo depois removeria a penalidade de dica e permitiria manipular o
    // placar. Só é verificado para cases que já existiam antes: um case novo
    // não tem valor antigo para comparar.
    function isMonotonic(field) {
      return !resource.data[field].exists()
        || (
             request.resource.data[field].keys().hasAll(resource.data[field].keys())
             && request.resource.data[field].keys().all(caseId,
                  !resource.data[field].keys().hasAny([caseId])
                  || request.resource.data[field][caseId].hasAll(
                       resource.data[field][caseId]
                     )
               )
           );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow delete: if false;

      allow create: if isOwner(userId)
        && hasOnlyProgressFields()
        && isValidProgressField('solvedByCase')
        && isValidProgressField('hintsUsedByCase');

      allow update: if isOwner(userId)
        && hasOnlyProgressFields()
        && isValidProgressField('solvedByCase')
        && isValidProgressField('hintsUsedByCase')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['solvedByCase', 'hintsUsedByCase']
           )
        && request.resource.data.diff(resource.data).affectedKeys().all(field,
             isMonotonic(field)
           );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
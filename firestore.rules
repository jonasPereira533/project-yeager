rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.keys().hasOnly(['solvedByCase', 'hintsUsedByCase'])
                      && (!('solvedByCase' in request.resource.data) || request.resource.data.solvedByCase is map)
                      && (!('hintsUsedByCase' in request.resource.data) || request.resource.data.hintsUsedByCase is map);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
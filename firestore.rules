rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validCaseIds() {
      return [
        'clientes-bloqueados',
        'estoque-abaixo-minimo',
        'motivos-cancelamento',
        'vendas-nao-efetivadas',
        'itens-fora-preco-tabela',
        'caixas-sem-fechamento',
        'compradores-unicos-alto-valor',
        'produtos-vendidos-prejuizo',
        'ranking-vendedores-filial',
        'icms-desonerado-devolucao',
        'valor-final-divergente-ipi',
        'vencimento-parcela-divergente',
        'caixa-travado-funcionario-inativo',
        'bug-troco-forma-pagamento'
      ];
    }

    function validObjectiveIds() {
      return ['o1', 'o2', 'o3'];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rascunhos de consulta guardam SQL livre, entao o tamanho e limitado
    // para ninguem estourar o limite de 1 MB do documento.
    function maxDraftSqlLength() {
      return 20000;
    }

    function hasOnlyAppFields() {
      return request.resource.data.keys().hasOnly(
        ['solvedByCase', 'hintsUsedByCase', 'draftsByCase']
      );
    }

    function isValidProgressMap(data) {
      return data is map
        && data.keys().hasOnly(validCaseIds())
        && data.values().all(objectiveList,
             objectiveList is list
             && objectiveList.size() <= validObjectiveIds().size()
             && objectiveList.all(objectiveId, objectiveId in validObjectiveIds())
           );
    }

    function isValidProgressField(name) {
      return !(name in request.resource.data) || isValidProgressMap(request.resource.data[name]);
    }

    // Rascunhos tem um nivel a mais: por caso, um objetivo ativo e um mapa
    // de objetivo para consulta.
    function isValidDraftsMap(data) {
      return data is map
        && data.keys().hasOnly(validCaseIds())
        && data.values().all(caseDraft,
             caseDraft is map
             && caseDraft.keys().hasOnly(['activeObjectiveId', 'queries'])
             && (!('activeObjectiveId' in caseDraft)
                 || caseDraft.activeObjectiveId in validObjectiveIds())
             && (!('queries' in caseDraft)
                 || (caseDraft.queries is map
                     && caseDraft.queries.keys().hasOnly(validObjectiveIds())
                     && caseDraft.queries.values().all(sql,
                          sql is string && sql.size() <= maxDraftSqlLength())))
           );
    }

    function isValidDraftsField(name) {
      return !(name in request.resource.data) || isValidDraftsMap(request.resource.data[name]);
    }

    // Progresso nunca retrocede: um objetivo resolvido continua resolvido.
    // Rascunhos sao o oposto, sao sobrescritos a cada tecla, entao ficam de
    // fora dessa verificacao.
    function isMonotonic(field) {
      return !resource.data[field].exists()
        || (
             request.resource.data[field].keys().hasAll(resource.data[field].keys())
             && request.resource.data[field].keys().all(caseId,
                  !resource.data[field].keys().hasAny([caseId])
                  || resource.data[field][caseId].hasAll(
                       resource.data[field][caseId]
                     )
               )
           );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow delete: if false;

      allow create: if isOwner(userId)
        && hasOnlyAppFields()
        && isValidProgressField('solvedByCase')
        && isValidProgressField('hintsUsedByCase')
        && isValidDraftsField('draftsByCase');

      allow update: if isOwner(userId)
        && hasOnlyAppFields()
        && isValidProgressField('solvedByCase')
        && isValidProgressField('hintsUsedByCase')
        && isValidDraftsField('draftsByCase')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['solvedByCase', 'hintsUsedByCase', 'draftsByCase']
           )
        && request.resource.data.diff(resource.data).affectedKeys().all(field,
             field == 'draftsByCase' || isMonotonic(field)
           );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}